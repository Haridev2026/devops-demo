pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        /opt/sonar-scanner-7.1.0.4889-linux-x64/bin/sonar-scanner \
                          -Dsonar.projectKey=devops-demo \
                          -Dsonar.projectName=devops-demo \
                          -Dsonar.sources=. \
                    '''
                }
            }
        }
    }
}
